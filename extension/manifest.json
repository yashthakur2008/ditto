{
  "manifest_version": 3,
  "name": "Ditto — Accessible Web",
  "version": "0.1.0",
  "description": "Rebuild the page you're on to match how you read — one click, no copy-pasting links.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rebuild this page with Ditto"
  },
  "options_page": "options.html",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://ditto-api.onrender.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"]
}
