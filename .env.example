# ── OpenAI + Claude (REQUIRED) ──────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_LIGHT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-latest

# ── ElevenLabs (optional — /voice/tts only) ─────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM

# ── Firebase / GCP (optional — analytics + profiles) ─
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
FIREBASE_PROJECT_ID=your_firebase_project_id

# ── Google Maps (optional — /maps endpoints only) ────
GOOGLE_MAPS_API_KEY=

# ── CORS (required in production) ────────────────────
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Render: set automatically via render.yaml (ditto-web URL)
# Manual: CORS_ORIGINS=https://your-frontend.onrender.com

# ── School pilot safety controls (optional) ───────────
# When enabled, Ditto only transforms URLs on approved domains.
SCHOOL_MODE=false
SCHOOL_ALLOWED_DOMAINS=example.edu,khanacademy.org

# ── App ──────────────────────────────────────────────
APP_ENV=development
PORT=8080

# ── Render notes ─────────────────────────────────────
# On Render, OPENAI_API_KEY and CLAUDE_API_KEY are required for the core product.
# Playwright runs in-process (no ActionLayer key needed).
# PORT is set automatically by Render — do not override.
