# ── Gemini (REQUIRED) ───────────────────────────────
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── ElevenLabs (optional — /voice/tts only) ─────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM

# ── Firebase / GCP (optional — analytics + profiles) ─
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
FIREBASE_PROJECT_ID=your_firebase_project_id

# ── Google Maps (optional — /maps endpoints only) ────
GOOGLE_MAPS_API_KEY=

# ── CORS (required in production) ────────────────────
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Render: set automatically via render.yaml (ditto-web URL)
# Manual: CORS_ORIGINS=https://your-frontend.onrender.com

# ── App ──────────────────────────────────────────────
APP_ENV=development
PORT=8080

# ── Render notes ─────────────────────────────────────
# On Render, only GEMINI_API_KEY is required for the core product.
# Playwright runs in-process (no ActionLayer key needed).
# PORT is set automatically by Render — do not override.
